APP_NAME=KAIT.ai
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL defaults match docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kait_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

# Compact KAIT №20 catalog loaded into memory.
DATA_PATH=./data/colleges.json

# API and Telegram runtime.
API_PORT=8000
APP_ENTRYPOINT=telegram
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT_SECONDS=8

# Public web API endpoint. Keep it in sync with KaitWidget.init({ apiUrl }).
PUBLIC_CHAT_PATH=/ambi/v1/dialog
PUBLIC_SESSION_CLOSE_PATH=/ambi/v1/session/close
PUBLIC_SESSION_RESET_PATH=/ambi/v1/session/reset
# Set to false on production after all widgets use PUBLIC_CHAT_PATH.
API_LEGACY_CHAT_ENABLED=true
# Comma-separated site origins allowed to call the API. Use your real HTTPS domain in production.
API_CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000
# Enable only when API is behind a trusted reverse proxy that sets X-Forwarded-*.
API_TRUST_PROXY_HEADERS=false
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_BODY_BYTES=16384
API_MAX_MESSAGE_CHARS=4000

# Debug log API is closed by default. Enable only for local/admin use.
API_LOGS_ENABLED=false
API_LOGS_TOKEN=
